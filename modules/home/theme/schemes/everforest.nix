# Everforest - Comfortable & Pleasant Color Scheme
# https://github.com/sainnhe/everforest
{
  # Base16 colors (dark hard variant)
  base00 = "#2b3339"; # Background
  base01 = "#323c41"; # Background dim
  base02 = "#3a454a"; # Background visual
  base03 = "#868d80"; # Grey 0
  base04 = "#9da9a0"; # Grey 1
  base05 = "#d3c6aa"; # Foreground
  base06 = "#e9e8d2"; # Light foreground
  base07 = "#fff9e8"; # White
  base08 = "#e67e80"; # Red
  base09 = "#e69875"; # Orange
  base0A = "#dbbc7f"; # Yellow
  base0B = "#a7c080"; # Green
  base0C = "#83c092"; # Aqua
  base0D = "#7fbbb3"; # Blue
