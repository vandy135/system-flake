  cyan = "#83c092";
  orange = "#e69875";
  pink = "#d699b6";
  teal = "#83c092";
  lavender = "#d699b6";
  mauve = "#d699b6";

  # Surface colors
  surface0 = "#323c41";
  surface1 = "#3a454a";
  surface2 = "#445055";
  overlay0 = "#4f585e";
  overlay1 = "#56635f";
  overlay2 = "#5f6d67";

  # Subtext
  subtext0 = "#859289";
  subtext1 = "#9da9a0";

  # GTK/Qt theme names
  gtkTheme = "Everforest-Dark-BL";
  iconTheme = "Papirus-Dark";
  cursorTheme = "Bibata-Modern-Classic";
}
