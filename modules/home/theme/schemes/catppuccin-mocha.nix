# Catppuccin Mocha - Soothing pastel theme for the high-spirited
# https://github.com/catppuccin/catppuccin
{
  # Base16 colors (for tools expecting base16 format)
  base00 = "#1e1e2e"; # Base (background)
  base01 = "#181825"; # Mantle
  base02 = "#313244"; # Surface0
  base03 = "#45475a"; # Surface1
  base04 = "#585b70"; # Surface2
  base05 = "#cdd6f4"; # Text
  base06 = "#f5e0dc"; # Rosewater
  base07 = "#b4befe"; # Lavender
  base08 = "#f38ba8"; # Red
  base09 = "#fab387"; # Peach
  base0A = "#f9e2af"; # Yellow
  base0B = "#a6e3a1"; # Green
  base0C = "#94e2d5"; # Teal
  base0D = "#89b4fa"; # Blue
  base0E = "#cba6f7"; # Mauve
  base0F = "#f2cdcd"; # Flamingo

  # Semantic colors
  background = "#1e1e2e";
  foreground = "#cdd6f4";
  cursorColor = "#f5e0dc";

  # Accent colors
  primary = "#cba6f7";   # Mauve - main accent
  secondary = "#89b4fa"; # Blue
  accent = "#f5e0dc";    # Rosewater

  # ANSI colors
  red = "#f38ba8";
  green = "#a6e3a1";
  yellow = "#f9e2af";
  blue = "#89b4fa";
  magenta = "#f5c2e7"; # Pink
  cyan = "#94e2d5";    # Teal
  orange = "#fab387";  # Peach
  pink = "#f5c2e7";
  teal = "#94e2d5";
  lavender = "#b4befe";
  mauve = "#cba6f7";

  # Surface colors (for UI elements)
  surface0 = "#313244";
  surface1 = "#45475a";
  surface2 = "#585b70";
  overlay0 = "#6c7086";
  overlay1 = "#7f849c";
  overlay2 = "#9399b2";

  # Subtext (muted text)
  subtext0 = "#a6adc8";
  subtext1 = "#bac2de";

  # GTK/Qt theme names
  gtkTheme = "catppuccin-mocha-mauve-standard+default";
  iconTheme = "Papirus-Dark";
  cursorTheme = "catppuccin-mocha-dark-cursors";
}
