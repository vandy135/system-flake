# Tokyo Night - A clean, dark theme that celebrates the lights of Tokyo
# https://github.com/enkia/tokyo-night-vscode-theme
{
  # Base16 colors
  base00 = "#1a1b26"; # Background
  base01 = "#16161e"; # Terminal black
  base02 = "#2f3549"; # Selection
  base03 = "#444b6a"; # Comments
  base04 = "#787c99"; # Dark foreground
  base05 = "#a9b1d6"; # Foreground
  base06 = "#cbccd1"; # Light foreground
  base07 = "#d5d6db"; # White
  base08 = "#f7768e"; # Red
  base09 = "#ff9e64"; # Orange
  base0A = "#e0af68"; # Yellow
  base0B = "#9ece6a"; # Green
  base0C = "#7dcfff"; # Cyan
  base0D = "#7aa2f7"; # Blue
  base0E = "#bb9af7"; # Magenta
  base0F = "#c0caf5"; # Light text

  # Semantic colors
  background = "#1a1b26";
  foreground = "#a9b1d6";
  cursorColor = "#c0caf5";

  # Accent colors
  primary = "#7aa2f7";   # Blue - main accent
  secondary = "#bb9af7"; # Purple
  accent = "#7dcfff";    # Cyan

  # ANSI colors
  red = "#f7768e";
  green = "#9ece6a";
  yellow = "#e0af68";
  blue = "#7aa2f7";
  magenta = "#bb9af7";
  cyan = "#7dcfff";
  orange = "#ff9e64";
  pink = "#ff007c";
  teal = "#1abc9c";
  lavender = "#c0caf5";
  mauve = "#bb9af7";

  # Surface colors
  surface0 = "#16161e";
  surface1 = "#232433";
  surface2 = "#2f3549";
  overlay0 = "#444b6a";
  overlay1 = "#565f89";
  overlay2 = "#787c99";

  # Subtext
  subtext0 = "#787c99";
  subtext1 = "#9aa5ce";

  # GTK/Qt theme names
  gtkTheme = "Tokyonight-Dark-BL";
  iconTheme = "Papirus-Dark";
  cursorTheme = "Bibata-Modern-Classic";
}
